# Copy to .env and adjust. Every value below is optional; the defaults are
# shown and work out of the box for local, single-user development.

# Database. Default: SQLite file in backend/.
# DATABASE_URL=sqlite:///./dev.db
# Or Postgres (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nucera

# Auth. CHANGE JWT_SECRET_KEY for anything beyond your own machine.
# JWT_SECRET_KEY=dev-only-insecure-secret-change-me
# JWT_EXPIRE_MINUTES=10080

# Local LLM (Ollama). Pull the model first: ollama pull llama3.2:3b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT_SECONDS=300
# Context window sent with every request (prompt + reply must fit). Prompts are
# sized to it; raising it costs memory and CPU time. Changing it makes Ollama
# reload the model, so tutor and quiz share one value.
# OLLAMA_NUM_CTX=4096
# OLLAMA_TEMPERATURE=0.2
# Longest tutor reply, in tokens (also the room kept free in the window).
# OLLAMA_MAX_OUTPUT_TOKENS=600

# Retrieval: chunks scoring below this similarity are never sent to the model
# or cited, and if none score above it the tutor won't answer. Depends on the
# embedding model and chunk size; re-check (tests/test_relevance_threshold.py)
# if either changes.
# RETRIEVAL_RELEVANCE_THRESHOLD=0.35

# Hybrid retrieval: vector ranking merged with an FTS5 keyword ranking (SQLite only).
# RETRIEVAL_HYBRID=true
# HYBRID_RRF_K=60
# HYBRID_LEXICAL_LIMIT=30

# Uploads (.pdf, .docx, .pptx, .txt, .md). Also caps pasted text, in characters.
# MAX_UPLOAD_MB=20
# OCR for scanned PDFs (needs pip install -r requirements-ocr.txt). One upload may
# contain at most OCR_MAX_PAGES scanned pages; a page with fewer than
# OCR_MIN_TEXT_CHARS characters and a picture counts as scanned.
# OCR_ENABLED=true
# OCR_MAX_PAGES=30
# OCR_MIN_TEXT_CHARS=30
# OCR_DPI=150
# OCR_MIN_CONFIDENCE=0.5

# Quiz generation. Quizzes are written in the background, one question per
# model call (about two minutes each on a CPU).
# QUIZ_QUESTION_COUNT=3
# Excerpts of your material given to the model for each question.
# QUIZ_MAX_EXCERPTS=3
# QUIZ_CONTEXT_CHAR_BUDGET=9000
# QUIZ_LLM_TIMEOUT_SECONDS=600
# QUIZ_TEMPERATURE=0.4
# Reply room reserved per question; the excerpts get what is left of the window.
# QUIZ_TOKENS_PER_QUESTION=300
# A running quiz job with no progress for this long is treated as dead.
# QUIZ_JOB_STALE_SECONDS=1500
