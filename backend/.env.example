# Copy to .env and adjust. Every value below is optional; the defaults are
# shown and work out of the box for local, single-user development.

# Database. Default: SQLite file in backend/.
# DATABASE_URL=sqlite:///./dev.db
# Or Postgres (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nucera

# Auth. CHANGE JWT_SECRET_KEY for anything beyond your own machine.
# JWT_SECRET_KEY=dev-only-insecure-secret-change-me
# JWT_EXPIRE_MINUTES=10080

# Local LLM (Ollama). Pull the model first: ollama pull llama3.2:3b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT_SECONDS=120

# Retrieval: below this top-match similarity the tutor won't answer.
# RETRIEVAL_RELEVANCE_THRESHOLD=0.35

# Uploads (.pdf, .txt, .md). Also caps pasted text, in characters.
# MAX_UPLOAD_MB=20

# Quiz generation.
# QUIZ_QUESTION_COUNT=5
# QUIZ_MIN_VALID_QUESTIONS=3
# QUIZ_MAX_EXCERPTS=8
# QUIZ_CONTEXT_CHAR_BUDGET=9000
# QUIZ_LLM_TIMEOUT_SECONDS=600
